        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estará en tu cuaderno la próxima vez que abras Gochimi."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elle sera dans ton carnet à la prochaine ouverture de Gochimi."
