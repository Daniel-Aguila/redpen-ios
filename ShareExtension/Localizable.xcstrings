    "It'll be in your notebook next time you open Gochimi." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sie ist in deinem Heft, sobald du Gochimi das nächste Mal öffnest."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estará en tu cuaderno la próxima vez que abras Gochimi."
