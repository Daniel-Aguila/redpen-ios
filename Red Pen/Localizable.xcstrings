    "If it could stand alone as a word, it gets a space." : {
      "comment" : "Tip for the grammar error where words are separated by spaces, but the word before the particle is not a word.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn es allein als Wort stehen könnte, kommt ein Leerzeichen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "S'il pourrait être un mot tout seul, il prend un espace."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kalau bisa berdiri sendiri sebagai kata, beri spasi."
