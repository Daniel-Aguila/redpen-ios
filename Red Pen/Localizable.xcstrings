    "Separate from politeness: honorifics show respect to the person you're talking about, even if they're not the one listening." : {
      "comment" : "Text describing the honorifics used in Korean.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Getrennt von der Höflichkeit: Höflichkeitsformen zeigen Respekt vor der Person, über die du sprichst, auch wenn sie nicht zuhört."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Différent de la politesse : les honorifiques montrent du respect envers la personne dont tu parles, même si ce n'est pas elle qui t'écoute."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Berbeda dari kesopanan: honorifik menunjukkan hormat kepada orang yang kamu bicarakan, meskipun dia bukan pendengarnya."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "丁寧さとは別のもので、敬語は話題にしている人への敬意を表します。その人が聞き手でなくても使います。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "É diferente da educação: os honoríficos mostram respeito à pessoa de quem você fala, mesmo que não seja ela quem está ouvindo."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ต่างจากความสุภาพ: คำยกย่องแสดงความเคารพต่อคนที่คุณพูดถึง แม้เขาจะไม่ใช่คนที่ฟังอยู่"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Khác với lịch sự: kính ngữ thể hiện sự tôn trọng với người bạn đang nói đến, kể cả khi người đó không phải người nghe."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "和礼貌程度不同:敬语是对你谈论的人表示尊敬,即使对方不在听。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "和禮貌程度不同:敬語是對你談論的人表示尊敬,即使對方不在聽。"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es distinto de la cortesía: los honoríficos muestran respeto hacia la persona de la que hablas, aunque no sea quien te escucha."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es distinto de la cortesía: los honoríficos muestran respeto hacia la persona de la que hablas, aunque no sea quien te escucha."
          }
        }
      }
    },
