          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verbes humbles, pour parler de toi : 주다 → 드리다, 묻다 → 여쭤보다"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kata kerja merendah, tentang dirimu: 주다 → 드리다, 묻다 → 여쭤보다"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "謙譲の動詞(自分のこと):주다 → 드리다、묻다 → 여쭤보다"
          }
