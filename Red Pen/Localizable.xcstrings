    "🍊 are only for decorations, styles and hats. Streak, Plus and Pro items can't be bought with them." : {
      "comment" : "A description of the price of a pack of tangerines.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los 🍊 solo sirven para decoración, estilos y gorros. Los objetos de racha, Plus y Pro no se pueden comprar con ellos."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los 🍊 solo sirven para decoración, estilos y gorros. Los objetos de racha, Plus y Pro no se pueden comprar con ellos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les 🍊 servent uniquement aux décorations, styles et chapeaux. Les objets de série, Plus et Pro ne s'achètent pas avec."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "🍊 sind nur für Deko, Stile und Hüte. Serien-, Plus- und Pro-Sachen kann man damit nicht kaufen."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As 🍊 servem só para decoração, estilos e chapéus. Itens de sequência, Plus e Pro não podem ser comprados com elas."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "🍊はデコレーション、スタイル、帽子専用です。連続記録・Plus・Proのアイテムは🍊では買えません。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "🍊 只能用于装饰、造型和帽子。连续打卡、Plus 和 Pro 的物品不能用它购买。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "🍊 只能用於裝飾、造型和帽子。連續打卡、Plus 和 Pro 的物品不能用它購買。"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "🍊 hanya untuk dekorasi, gaya, dan topi. Barang streak, Plus, dan Pro tidak bisa dibeli dengan 🍊."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "🍊 ใช้ได้กับของตกแต่ง สไตล์ และหมวกเท่านั้น ของจากสถิติต่อเนื่อง Plus และ Pro ซื้อด้วย 🍊 ไม่ได้"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "🍊 chỉ dùng cho đồ trang trí, kiểu dáng và mũ. Đồ chuỗi ngày, Plus và Pro không mua được bằng 🍊."
          }
        }
      }
    },
