    "Keeps your notebook on all your Apple devices. Changes take effect the next time you open Gochimi." : {
      "comment" : "A description of iCloud syncing.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hält dein Heft auf all deinen Apple-Geräten. Änderungen gelten beim nächsten Öffnen von Gochimi."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Garde ton carnet sur tous tes appareils Apple. Les changements s'appliquent à la prochaine ouverture de Gochimi."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menyimpan bukumu di semua perangkat Apple. Perubahan berlaku saat kamu membuka Gochimi berikutnya."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "すべてのAppleデバイスでノートを同期します。変更は次にGochimiを開いたときに反映されます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantém seu caderno em todos os seus dispositivos Apple. As mudanças valem na próxima vez que você abrir o Gochimi."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เก็บสมุดไว้ในทุกอุปกรณ์ Apple ของคุณ การเปลี่ยนแปลงจะมีผลเมื่อเปิด Gochimi ครั้งถัดไป"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Giữ sổ của bạn trên mọi thiết bị Apple. Thay đổi có hiệu lực vào lần tới bạn mở Gochimi."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在你所有的 Apple 设备上同步笔记本。更改会在下次打开 Gochimi 时生效。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在你所有的 Apple 裝置上同步筆記本。更改會在下次開啟 Gochimi 時生效。"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantiene tu cuaderno en todos tus dispositivos Apple. Los cambios se aplican la próxima vez que abras Gochimi."
          }
        },
        "es-419" : {
          "stringUnit" : {
